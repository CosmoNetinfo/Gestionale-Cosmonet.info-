# Copia questo file in .env.local e compila i valori. Non committare mai .env.local.

# Protezione dell'app (obbligatoria in produzione)
APP_PASSWORD=

# WordPress (REST API standard + Application Password: Utenti > Profilo)
WP_BASE_URL=https://www.cosmonet.info
WP_USER=
WP_APP_PASSWORD=

# GitHub: token personale con sola lettura sui repository (vede anche le private).
# In alternativa solo GITHUB_USER per vedere le pubbliche.
GITHUB_TOKEN=
GITHUB_USER=CosmoNetinfo

# Giorni dopo i quali un articolo va rivisto
REVIEW_DAYS=90

# Search Console (account di servizio Google)
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE=sc-domain:cosmonet.info

# Supabase (revisioni). La chiave SEGRETA non va mai messa su GitHub.
SUPABASE_URL=https://cupudcsawfvdzpmebudh.supabase.co
SUPABASE_SECRET_KEY=

# Server MCP per Claude: stringa casuale lunga (almeno 32 caratteri). L'indirizzo sarà /api/mcp/<MCP_TOKEN>
MCP_TOKEN=

# Cosmo Memo in sola lettura (serve prima il brief in docs/brief-cosmomemo-api.md)
COSMOMEMO_URL=https://cosmo-memo.vercel.app
COSMOMEMO_READ_TOKEN=

# Canali (opzionali)
DISCORD_INVITE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storico di Search Console (cron giornaliero su Vercel). Valore a caso, lungo; Vercel lo invia da solo al cron.
CRON_SECRET=

# PageSpeed Insights (pagina Velocità): chiave API di Google Cloud
PAGESPEED_API_KEY=
